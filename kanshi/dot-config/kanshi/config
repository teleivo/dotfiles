# Kanshi configuration for automatic monitor switching. kanshi applies the first profile matching
# the connected outputs, so the specific monitors must come before the catch-all.
#
# External monitors are matched by description (make model serial) instead of connector name so
# they work on any port (DP-1, DP-2, ...). The laptop screen is disabled while one is connected.

profile laptop {
    output eDP-1 enable scale 2 position 0,0
    exec swaymsg output '*' scale_filter linear
}

profile dell-u2725qe {
    output "Dell Inc. DELL U2725QE F00HJF4" enable mode 3840x2160 scale 1.5 position 0,0
    output eDP-1 disable
    exec swaymsg output '*' scale_filter linear
}

profile dell-u2723qe {
    output "Dell Inc. DELL U2723QE FNZ44P3" enable mode 3840x2160 scale 1.5 position 0,0
    output eDP-1 disable
    exec swaymsg output '*' scale_filter linear
}

# Any other external monitor. No mode since it may not support 4K; its preferred mode is used.
profile external {
    output * enable scale 1.5 position 0,0
    output eDP-1 disable
    exec swaymsg output '*' scale_filter linear
}
